{
  "version": 2,
  "configurePresets": [
    {
      "name": "x86_64-linux",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchains/x86_64-linux.cmake"
      }
    },
    {
      "name": "aarch64-linux",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchains/aarch64-linux.cmake"
      }
    },
    {
      "name": "riscv64-linux",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "riscv64-linux-release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchains/riscv64-linux.cmake"
      }
    },
    {
      "name": "x86_64-windows",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static-release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchains/x86_64-windows.cmake",
        "CMAKE_EXE_LINKER_FLAGS": "$penv{EXTRA_LINK_FLAGS} --static"
      }
    },
    {
      "name": "arm64-darwin",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-release"
      }
    }
  ]
}
